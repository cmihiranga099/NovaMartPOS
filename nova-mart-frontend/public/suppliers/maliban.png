        <!-- Cookie Consent Script -->

        <script>
            window.addEventListener("load", function () {
                setTimeout(function () {
                    var cookieScript = document.createElement("script");
                    cookieScript.src = "https://cdn.websitepolicies.io/lib/cookieconsent/1.0.3/cookieconsent.min.js";
                    cookieScript.async = true;

                    cookieScript.onload = function () {
                        if (window.wpcc && typeof window.wpcc.init === "function") {
                            window.wpcc.init({
                                "border": "normal",
                                "corners": "small",
                                "colors": {
                                    "popup": {
                                        "background": "#000000",
                                        "text": "#ffffff",
                                        "border": "#000000"
                                    },
                                    "button": {
                                        "background": "#23d700",
                                        "text": "#000000"
                                    }
                                },
                                "padding": "small",
                                "margin": "small",
                                "content": {
                                    "button": "Allow Cookies"
                                }
                            });
                        }
                    };

                    document.body.appendChild(cookieScript);
                }, 3000);
            });
        </script>

        <style>
            .seo-hidden-link-text {
                position: absolute !important;
                width: 1px !important;
                height: 1px !important;
                padding: 0 !important;
                margin: -1px !important;
                overflow: hidden !important;
                clip: rect(0, 0, 0, 0) !important;
                white-space: nowrap !important;
                border: 0 !important;
            }
        </style>

        <script>
            window.addEventListener("load", function () {
                function fixCookieLearnMoreAccessibility() {
                    var cookieLinks = document.querySelectorAll('a[href*="internetcookies.com"]');

                    cookieLinks.forEach(function (link) {
                        link.setAttribute("aria-label", "Learn more about InternetCookies cookie information");
                        link.setAttribute("title", "Learn more about InternetCookies cookie information");

                        if (!link.querySelector(".seo-hidden-link-text")) {
                            link.innerHTML = 'Learn more<span class="seo-hidden-link-text"> about InternetCookies cookie information</span>';
                        }
                    });
                }

                fixCookieLearnMoreAccessibility();

                var observer = new MutationObserver(function () {
                    fixCookieLearnMoreAccessibility();
                });

                observer.observe(document.body, {
                    childList: true,
                    subtree: true
                });

                setTimeout(function () {
                    observer.disconnect();
                }, 10000);
            });
        </script>

