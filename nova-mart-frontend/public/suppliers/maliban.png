    <!-- Duplicate jQuery 3.3.1 removed. jQuery 1.12.4 is kept for Bootstrap 3 and existing inline scripts. -->
    <style id="mobile-lcp-fcp-fix">
        /* 1. Global Font Swap */
        /* Restore page background color - desktop + mobile */
        body,
        .content-example,
        #scrollTo {
            background-color: #f3f0e7 !important;
        }

        @media (max-width: 768px) {

            /* Restore original mobile page background color */
            body,
            .content-example,
            #scrollTo,
            .container-cs {
                background-color: #f3f0e7 !important;
            }

            .banner-wrapper {
                min-height: 210px;
                display: block;
                overflow: hidden;
            }

            .banner-wrapper img {
                aspect-ratio: 1400 / 785;
                width: 100%;
                height: auto;
            }

            /* 3. Mobile Logo Fix */
            .hidden-sm,
            .hidden-xs {
                display: none !important;
            }

            .navbar-header,
            .navbar-brand.mini-mobile {
                min-height: 50px;
            }

            /* 4. Call Now Button */
            .call_now_btn {
                display: inline-block !important;
                min-height: 45px !important;
            }

            .call_now_btn img {
                width: auto !important;
                height: 45px !important;
                object-fit: contain;
            }

            #scrollTo>.row>div:first-child {
                min-height: 90px !important;
                contain: layout;
                display: block;
            }

            /* 6. Explore Section Text Block Fix */
            .container-cs:not(#scrollTo)>.row>div:first-child {
                min-height: 120px !important;
                contain: layout;
                display: block;
            }

            /* 7. Image Grid Fix */
            .zoomInContainer img {
                width: 100% !important;
                height: auto !important;
                object-fit: contain;
            }

            a[href="/maliban-biscuit"] img {
                aspect-ratio: 360 / 433 !important;
            }

            a[href="/maliban-milk"] img {
                aspect-ratio: 360 / 434 !important;
            }

            a[href="/maliban-agri"] img {
                aspect-ratio: 360 / 433 !important;
            }

            a[href="/little-lion"] img {
                aspect-ratio: 407 / 493 !important;
            }

            /* 8. Popup fix */
            #gmg-side-popup {
                min-height: 65px;
                contain: content;
            }
        }

        /* 9. Permanent CLS fix for Home Banner */
        .banner-wrapper {
            position: relative !important;
            display: block !important;
            width: 100% !important;
            max-width: 100% !important;
            aspect-ratio: 1400 / 785 !important;
            min-height: auto !important;
            height: auto !important;
            line-height: 0 !important;
            overflow: hidden !important;
        }

        .banner-wrapper picture {
            display: block !important;
            width: 100% !important;
            aspect-ratio: 1400 / 785 !important;
            line-height: 0 !important;
        }

        .banner-wrapper img {
            display: block !important;
            width: 100% !important;
            height: auto !important;
            aspect-ratio: 1400 / 785 !important;
            object-fit: cover !important;
        }

        /* Footer color fix - desktop + mobile */
        body>.col-xs-12[style*="#ae0a09"],
        body>.col-xs-12[style*="background-color:#ae0a09"] {
            background-color: #ae0a09 !important;
        }

        body>.col-xs-12[style*="#ae0a09"] .container-cs,
        body>.col-xs-12[style*="background-color:#ae0a09"] .container-cs,
        body>.col-xs-12[style*="#ae0a09"] .row,
        body>.col-xs-12[style*="background-color:#ae0a09"] .row,
        body>.col-xs-12[style*="#ae0a09"] .footer-award-logos,
        body>.col-xs-12[style*="background-color:#ae0a09"] .footer-award-logos {
            background-color: transparent !important;
        }

        /* FINAL mobile footer fix */
        @media (max-width: 768px) {

            div[style*="background-color:#ae0a09"],
            div[style*="#ae0a09"] {
                background-color: #ae0a09 !important;
            }

            div[style*="background-color:#ae0a09"] .container-cs,
            div[style*="#ae0a09"] .container-cs,
            div[style*="background-color:#ae0a09"] .row,
            div[style*="#ae0a09"] .row,
            div[style*="background-color:#ae0a09"] .footer-award-logos,
            div[style*="#ae0a09"] .footer-award-logos {
                background-color: transparent !important;
            }
        }

        /* FINAL CLS fix for Explore section - mobile only */
        @media (max-width: 768px) {
            .container.container-cs:not(#scrollTo) {
                min-height: 250px !important;
            }

            .container.container-cs:not(#scrollTo)>.row {
                min-height: 230px !important;
            }

            .container.container-cs:not(#scrollTo)>.row>.col-lg-12.l-mr-top.l-mr-bottom {
                min-height: 165px !important;
            }

            .container.container-cs:not(#scrollTo) h1.w-600.text-center {
                min-height: 92px !important;
                line-height: 1.12 !important;
                margin-top: 20px !important;
                margin-bottom: 10px !important;
            }

            .container.container-cs:not(#scrollTo) p.para.w-600.text-center {
                min-height: 22px !important;
                line-height: 1.35 !important;
                margin-bottom: 10px !important;
            }



        }
    </style>
</head>

<body>
    <div class="content-example">
        <!-- Start Component -->

        <div id="gmg-side-popup" class="gmg-side-popup">
            <div class="gmg-sp-header">
                <div class="gmg-sp-ballon icon-ballon">
                    <img class="img-responsive" style="width:100%; height:auto; aspect-ratio: 120 / 55;"
                        alt="Contact us" width="120" height="55" loading="lazy" decoding="async"
                        src="/wp-content/uploads/mobile-optimized/tele-icon-mobile.webp">
                    <h3 class="title">Contact Us</h3>
                </div>

                <div class="gmg-sp-content">
                    <img class="img-responsive" style="width:100%; height:auto; aspect-ratio: 240 / 200;"
                        alt="Contact Form" width="240" height="200" loading="lazy" decoding="async" fetchpriority="low"
                        src="/wp-content/uploads/local-cache/theme/images-min/common/new-contact2.jpg">
                </div>

            </div> <!-- GMG Side Popup -->
            <!-- GMG Side Popup FORM -->
            <!-- End Component -->
        </div>

        <a href="https://ebadge.bestweb.lk/api/v1/clicked/malibangroup.lk/TopWeb/2026-June/Qualified"
            class="floating-ebadge">
            <img src="https://ebadge.bestweb.lk/eBadgeSystem/domainNames/malibangroup.lk/TopWeb/2026-June/Qualified/image.png"
                alt="logo" width="130" height="130" />
        </a>

        <style>
            .floating-ebadge {
                position: fixed;
                bottom: 100px;
                left: 20px;
                z-index: 99999;
                transition: transform 0.3s ease;
                display: block;
            }

            .floating-ebadge:hover {
                transform: scale(1.05);
            }

            @media (max-width: 768px) {
                .floating-ebadge {
                    bottom: 20px;
                    /* Adjusting bottom slightly on mobile if needed, though preserving 100px is fine too. Let's keep 100px */
                    left: 10px;
                    bottom: 100px;
                    display: block !important;
                    visibility: visible !important;
                    opacity: 1 !important;
                }

                .floating-ebadge img {
                    width: 100px !important;
                    height: 100px !important;
                    display: block !important;
                }
            }

            /* Not neccesary */
            .content-example {
                display: block;
                margin: 0 auto;
                position: relative;
                background: #fff;
            }

            .gmg-side-popup .title {
                margin: 0;
            }

            /* Not neccesary */


            /*------ GMG Side Popup --------*/
            .gmg-side-popup {
                cursor: pointer;
                width: 172px;
                height: 65px;
                position: fixed;
                right: 0px;
                bottom: 145px;
                background: transparent;
                transition: all 0.8s ease;
                z-index: 999;
                overflow: hidden;
            }

            .gmg-side-popup.open {
                width: 240px;
                height: 252px;
            }

            .gmg-sp-close {
                font-size: 12px;
                font-weight: bold;
                position: absolute;
                top: 6px;
                right: 5px;
                color: #fff;
                cursor: pointer;
                -webkit-transition: all 0.3s ease-in-out;
                -moz-transition: all 0.3s ease-in-out;
                -ms-transition: all 0.3s ease-in-out;
                -o-transition: all 0.3s ease-in-out;
                transition: all 0.3s ease-in-out;
            }

            .gmg-side-popup.open .gmg-sp-close {
                -moz-transform: rotate(-135deg);
                -webkit-transform: rotate(-135deg);
                -o-transform: rotate(-135deg);
                -ms-transform: rotate(-135deg);
                transform: rotate(-135deg);
            }

            .gmg-sp-ballon {
                height: 35px;
                width: 120px;
                display: block;
                margin: 0 auto;
                padding: 13px 0;
            }

            .gmg-sp-ballon svg {
                width: 35px;
                height: 35px;
                fill: #fff;
            }

            .gmg-side-popup .title,
            .gmg-side-popup .gmg-sp-content {
                float: left;
                width: 100%;
                box-sizing: border-box;
                opacity: 0;
                visibility: hidden;
            }

            .gmg-side-popup.open .title,
            .gmg-side-popup.open .gmg-sp-content {
                opacity: 1;
                visibility: visible;
            }

            .gmg-side-popup .title {
                min-width: 220px;
                font-size: 14px;
                font-weight: normal;
                text-align: center;
                color: transparent;
                letter-spacing: 1px;
                text-transform: uppercase;
            }

            .gmg-sp-content {
                padding: 0 8px;
            }

            .gmg-sp-button {
                display: flex;
                float: left;
                width: 100%;
                min-width: 220px;
                min-height: 60px;
                background: #fff;
                line-height: 18px;
                color: #5c6770;
                align-items: center;
                border-bottom: 1px solid #ccc;
            }

            a.gmg-sp-button:hover {
                background: #fbfbfb;
                text-decoration: none;
            }

            .gmg-sp-button.tell {
                cursor: default;
            }

            .gmg-side-popup .gmg-sp-button:nth-child(3) {
                border: 0;
            }

            .gmg-sp-button .desc {
                font-size: 14px;
            }

            .gmg-sp-button .icon {
                padding: 10px;
                font-size: 14px;
            }

            .gmg-side-popup .title,
            .gmg-side-popup-form .title {
                line-height: 40px;
            }

            /*------ GMG Side Popup FORM --------*/
            .gmg-side-popup-form {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                overflow: auto;
                z-index: 9999;

            }

            .gmg-spf-container {
                width: 258px;
                height: 400px;
                background: #5c6770;
                padding: 10px;
                position: absolute;
                top: 120px;
                left: 50%;
                margin-left: -129px;
                -webkit-box-sizing: border-box;
                -moz-box-sizing: border-box;
                box-sizing: border-box;
                z-index: 999;
            }

            .gmg-spf-overlay {
                background: #000;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                z-index: 99;
                opacity: 0.4;
            }

            .gmg-spf-close {
                position: absolute;
                top: 0;
                right: 10px;
                color: #fff;
            }

            .gmg-spf-header,
            .gmg-spf-content,
            .gmg-spf-header * {
                float: left;
                width: 100%;
                margin: 0;
                box-sizing: border-box;
            }

            .gmg-spf-header .icon {
                padding: 15px 0 5px;
                font-size: 26px;
                color: #fff;
                text-align: center;
            }

            .gmg-spf-header .title {
                text-align: center;
                color: #fff;
                font-size: 14px;
                font-weight: 400;
                letter-spacing: 1px;
            }

            .gmg-spf-content {
                background: #fff;
                height: calc(100% - 87px);

                color: #000;
            }

            [class^="icon-"],
            [class*=" icon-"] {
                /* use !important to prevent issues with browser extensions that change fonts */
                font-family: 'gmg-icons' !important;
                speak: none;
                font-style: normal;
                font-weight: normal;
                font-variant: normal;
                text-transform: none;
                line-height: 1;

                /* Better Font Rendering =========== */
                -webkit-font-smoothing: antialiased;
                -moz-osx-font-smoothing: grayscale;
            }

            .icon-plus svg {
                width: 10px;
                height: 10px;
                fill: #fff;
            }

            .icon-clock svg,
            .icon-phone svg {
                fill: #5c6770;
                width: 16px;
            }
        </style>

