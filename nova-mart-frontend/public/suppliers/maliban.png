            <script>
                (function () {
                    var lazyBgCards = document.querySelectorAll('.lazy-bg[data-bg]');

                    function loadBgImage(card) {
                        var imageUrl = card.getAttribute('data-bg');
                        if (!imageUrl) return;

                        card.style.backgroundImage = "url('" + imageUrl + "')";
                        card.removeAttribute('data-bg');
                        card.classList.remove('lazy-bg');
                    }

                    if (!('IntersectionObserver' in window)) {
                        lazyBgCards.forEach(loadBgImage);
                        return;
                    }

                    var observer = new IntersectionObserver(function (entries, obs) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                loadBgImage(entry.target);
                                obs.unobserve(entry.target);
                            }
                        });
                    }, {
                        rootMargin: '150px 0px',
                        threshold: 0.01
                    });

                    lazyBgCards.forEach(function (card) {
                        observer.observe(card);
                    });
                })();
            </script>
