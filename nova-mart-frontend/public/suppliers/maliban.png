            <style>
                /* Chatbot popup box - LEFT side same as live */
                .chat-container {
                    position: fixed;
                    bottom: 100px;
                    left: 30px;
                    width: 380px;
                    height: 550px;
                    padding: 18px;
                    box-sizing: border-box;
                    display: none;
                    flex-direction: column;
                    overflow: hidden;
                    font-family: 'Segoe UI', Arial, sans-serif;
                    z-index: 9999;

                    background: rgba(255, 255, 255, 0.14);
                    border: 1.5px solid rgba(255, 255, 255, 0.78);
                    box-shadow:
                        0 24px 70px rgba(0, 0, 0, 0.2),
                        inset 0 1px 0 rgba(255, 255, 255, 0.95),
                        inset 0 -1px 0 rgba(255, 255, 255, 0.35);
                    backdrop-filter: blur(28px) saturate(180%);
                    -webkit-backdrop-filter: blur(28px) saturate(180%);
                }

                .chat-container::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    pointer-events: none;
                    background: linear-gradient(145deg,
                            rgba(255, 255, 255, 0.9) 0%,
                            rgba(255, 255, 255, 0.22) 32%,
                            rgba(255, 255, 255, 0.08) 55%,
                            rgba(255, 255, 255, 0.45) 100%);
                    opacity: 0.55;
                    z-index: 0;
                }

                .chat-container>* {
                    position: relative;
                    z-index: 1;
                }

                /* Launcher icon - keep same first look */
                .chatbot-launcher {
                    position: fixed;
                    bottom: 25px;
                    left: 30px;
                    width: 65px;
                    height: 65px;
                    background: #d8262f;
                    border-radius: 50px !important;
                    box-shadow: 0 4px 15px rgba(216, 38, 47, 0.4);
                    cursor: pointer;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    z-index: 10000;
                }

                .chatbot-launcher img {
                    width: 65%;
                    filter: brightness(0) invert(1);
                }

                .ai-tag-custom {
                    position: absolute;
                    top: -2px;
                    right: -2px;
                    background: #8dc63f;
                    color: white;
                    font-size: 10px;
                    padding: 3px 7px;
                    border-radius: 50px !important;
                    font-weight: bold;
                    border: 2px solid white;
                }

                .chat-header {
                    background: rgba(255, 255, 255, 0.94);
                    color: #333333;
                    padding: 18px 24px;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    border: 1px solid rgba(82, 82, 82, 0.1);
                    border-bottom: none;
                    flex-shrink: 0;
                }

                .header-left-bot {
                    width: 32px;
                    height: 32px;
                    background-color: #d8262f;
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    overflow: hidden;
                }

                .header-left-bot img {
                    width: 75%;
                    height: 75%;
                    object-fit: contain;
                    filter: brightness(0) invert(1);
                }

                .chat-close-btn {
                    background: transparent;
                    border: none;
                    color: #525252;
                    font-size: 24px;
                    cursor: pointer;
                    height: 30px;
                    width: 30px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    border-radius: 50%;
                    padding: 0;
                    margin: 0;
                    line-height: 1;
                }

                .chat-close-btn:hover {
                    background: rgba(0, 0, 0, 0.04);
                }

                .chat-body {
                    flex: 1;
                    padding: 20px;
                    overflow-y: auto;
                    display: block;
                    background: rgba(239, 244, 249, 0.82);
                    scroll-behavior: smooth;
                    border-left: 1px solid rgba(82, 82, 82, 0.1);
                    border-right: 1px solid rgba(82, 82, 82, 0.1);
                }

                .msg-row-bot {
                    display: flex;
                    align-items: flex-start;
                    gap: 10px;
                    justify-content: flex-start;
                    margin-bottom: 16px;
                }

                .msg-row-user {
                    display: flex;
                    flex-direction: row-reverse;
                    align-items: flex-start;
                    gap: 10px;
                    justify-content: flex-start;
                    margin-bottom: 16px;
                }

                .bot-bubble {
                    color: #ffffff;
                    background: linear-gradient(135deg, #d8262f 0%, #b81720 45%, #7f1118 100%);
                    padding: 14px 16px;
                    border-radius: 14px;
                    border-top-left-radius: 4px;
                    font-size: 14px;
                    line-height: 1.5;
                    border: 1px solid rgba(255, 255, 255, 0.18);
                    max-width: calc(85% - 34px);
                    margin-right: auto;
                    box-shadow: 0 10px 25px rgba(40, 40, 40, 0.12);
                    word-wrap: break-word;
                }

                .user-bubble {
                    color: #525252;
                    background: #ffffff;
                    padding: 14px 16px;
                    border-radius: 14px;
                    border-top-right-radius: 4px;
                    font-size: 14px;
                    line-height: 1.5;
                    border: none;
                    max-width: 85%;
                    margin-left: auto;
                    box-shadow: 0 10px 25px rgba(40, 40, 40, 0.12);
                    word-wrap: break-word;
                }

                .avatar-bot,
                .avatar-user {
                    width: 24px;
                    height: 24px;
                    min-width: 24px;
                    border-radius: 50%;
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    flex-shrink: 0;
                    margin-top: 8px;
                }

                .avatar-bot {
                    background: transparent;
                }

                .avatar-user {
                    background: #d8262f;
                    color: #ffffff;
                    font-size: 13px;
                }

                .avatar-user svg {
                    width: 14px;
                    height: 14px;
                    display: block;
                    color: #ffffff;
                }

                .avatar-bot img {
                    width: 24px;
                    height: 24px;
                    object-fit: contain;
                    display: block;
                    opacity: 1 !important;
                    filter: brightness(0) saturate(100%) invert(22%) sepia(97%) saturate(2582%) hue-rotate(342deg) brightness(91%) contrast(98%) !important;

                }

                .pill-group {
                    display: none;
                }

                .input-wrapper {
                    padding: 16px 20px;
                    border: 1px solid rgba(82, 82, 82, 0.2);
                    display: flex;
                    gap: 12px;
                    background: rgba(255, 255, 255, 0.94);
                    align-items: center;
                    flex-shrink: 0;
                }

                .gradient-input {
                    width: 100%;
                    background: transparent;
                    border-radius: 0;
                    display: flex;
                    align-items: center;
                    padding: 0;
                    gap: 12px;
                }

                .gradient-input input {
                    flex: 1;
                    padding: 12px 16px;
                    border: 1px solid #d8d8d8;
                    border-radius: 999px !important;
                    outline: none;
                    font-size: 14px;
                    font-family: inherit;
                    margin: 0;
                    background: #ffffff;
                    color: #333333;
                    appearance: none;
                    -webkit-appearance: none;
                }

                .gradient-input input::placeholder {
                    color: #8a8f94;
                }

                .gradient-input input:focus {
                    border-color: #d8262f;
                    box-shadow: 0 0 0 2px rgba(216, 38, 47, 0.14);
                }

                .chat-send-btn {
                    background: linear-gradient(135deg, #d8262f 0%, #b81720 45%, #7f1118 100%);
                    color: white !important;
                    border: none;
                    padding: 0;
                    border-radius: 50%;
                    cursor: pointer;
                    width: 40px;
                    height: 40px;
                    min-width: 40px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 20px !important;
                    line-height: 1;
                    margin: 0;
                }

                .chat-send-btn:hover {
                    transform: scale(1.05);
                }

                .typing-bubble {
                    display: flex;
                    align-items: center;
                    gap: 4px;
                    color: #ffffff;
                    background: linear-gradient(135deg, #d8262f 0%, #b81720 45%, #7f1118 100%);
                    padding: 14px 16px;
                    border-radius: 14px;
                    border-top-left-radius: 4px;
                    box-shadow: 0 10px 25px rgba(40, 40, 40, 0.12);
                }

                .typing-bubble span {
                    width: 8px;
                    height: 8px;
                    background: #ffffff;
                    border-radius: 50%;
                    opacity: 0.6;
                    animation: chatbotBounce 1.2s infinite;
                }

                .typing-bubble span:nth-child(2) {
                    animation-delay: 0.2s;
                }

                .typing-bubble span:nth-child(3) {
                    animation-delay: 0.4s;
                }

                @keyframes chatbotBounce {

                    0%,
                    100% {
                        transform: translateY(0);
                    }

                    50% {
                        transform: translateY(-5px);
                        opacity: 1;
                    }
                }

                .bot-bubble a {
                    color: #ffffff;
                    font-weight: 600;
                    text-decoration: underline;
                }

                .chat-body::-webkit-scrollbar {
                    width: 6px;
                }

                .chat-body::-webkit-scrollbar-track {
                    background: #f1f1f1;
                }

                .chat-body::-webkit-scrollbar-thumb {
                    background: #d0d0d0;
                    border-radius: 10px;
                }

                @media (max-width: 768px) {
                    .chat-container {
                        background: rgba(255, 255, 255, 0.92);
                        border: 1px solid rgba(230, 230, 230, 0.9);
                        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12);
                        backdrop-filter: none;
                        -webkit-backdrop-filter: none;
                    }

                    .chat-container::before {
                        display: none;
                    }
                }

                @media (max-width: 480px) {
                    .chat-container {
                        width: 85vw;
                        height: 80vh;
                        bottom: 90px;
                        left: 10px;
                        padding: 14px;
                    }

                    .chat-header {
                        padding: 14px 18px;
                    }

                    .chat-body {
                        padding: 14px;
                    }

                    .input-wrapper {
                        padding: 12px 14px;
                    }

                    .gradient-input input {
                        font-size: 13px;
                        padding: 10px 14px;
                    }
                }
            </style>

            <div class="chatbot-launcher" onclick="toggleChat()">
                <img src="/wp-content/uploads/local-cache/theme/images-min/images/chat_1_-1.webp" alt="Chatbot"
                    width="42" height="42" loading="lazy" decoding="async">
                <span class="ai-tag-custom">AI</span>
            </div>

            <div class="chat-container" id="chat-container">
                <div class="chat-header">
                    <div class="header-left-bot">
                        <img src="/wp-content/uploads/local-cache/theme/images-min/images/chat_1_-1.webp" alt="Chatbot"
                            width="24" height="24" loading="lazy" decoding="async">
                    </div>
                    <button class="chat-close-btn" type="button" onclick="toggleChat()"
                        aria-label="Close chatbot">&times;</button>
                </div>

                <div class="chat-body" id="chat-body">
                    <div class="msg-row-bot">
                        <div class="avatar-bot">
                            <img src="/wp-content/uploads/local-cache/theme/images-min/images/chat_1_-1.webp"
                                alt="Chatbot" width="24" height="24" loading="lazy" decoding="async">
                        </div>
                        <div class="bot-bubble">
                            <strong>Hi, I am an AI chatbot. How can I help you today?</strong>
                        </div>
                    </div>
                </div>

                <div class="input-wrapper">
                    <div class="gradient-input">
                        <input type="text" id="userInput" placeholder="Type your message here..."
                            onkeypress="handleKeyPress(event)">
                        <button class="chat-send-btn" type="button" onclick="sendMessage()" aria-label="Send message">
                            &#10148;
                        </button>
                    </div>
                </div>
            </div>

            <script>
                const MALIBAN_CHATBOT_ICON = "/wp-content/uploads/local-cache/theme/images-min/images/chat_1_-1.webp";
                const MALIBAN_CHATBOT_WEBHOOK = "https://phantom.3cs.website/webhook/7ee78716-4d07-4768-8f5f-9e9eaa269766";

                let sessionId = sessionStorage.getItem("sessionId");

                if (!sessionId) {
                    sessionId = "86" + Math.random().toString(36).substr(2, 9);
                    sessionStorage.setItem("sessionId", sessionId);
                }

                function toggleChat() {
                    const chatContainer = document.getElementById("chat-container");

                    if (!chatContainer) return;

                    const isOpening = chatContainer.style.display !== "flex";
                    chatContainer.style.display = isOpening ? "flex" : "none";

                    if (isOpening) {
                        setTimeout(function () {
                            const input = document.getElementById("userInput");
                            if (input) input.focus();
                        }, 100);
                    }
                }

                function escapeChatHtml(value) {
                    return String(value)
                        .replace(/&/g, "&amp;")
                        .replace(/</g, "&lt;")
                        .replace(/>/g, "&gt;")
                        .replace(/"/g, "&quot;")
                        .replace(/'/g, "&#039;");
                }

                function parseMarkdown(text) {
                    if (!text) return "";

                    let safeText = escapeChatHtml(text);

                    safeText = safeText.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");
                    safeText = safeText.replace(
                        /\[(.*?)\]\((https?:\/\/.*?)\)/g,
                        '<a href="$2" target="_blank" rel="noopener noreferrer">$1</a>'
                    );

                    return safeText.replace(/\n/g, "<br>");
                }

                function addMessage(content, type, isMd = false, id = null) {
                    const body = document.getElementById("chat-body");

                    if (!body) return;

                    const row = document.createElement("div");
                    row.className = type === "bot" ? "msg-row-bot" : "msg-row-user";

                    if (id) row.id = id;

                    if (type === "bot") {
                        row.innerHTML =
                            '<div class="avatar-bot">' +
                            '<img src="' + MALIBAN_CHATBOT_ICON + '" alt="Chatbot" width="24" height="24" loading="lazy" decoding="async">' +
                            '</div>' +
                            '<div class="bot-bubble">' +
                            (isMd ? parseMarkdown(content) : escapeChatHtml(content)) +
                            '</div>';
                    } else {
                        row.innerHTML =
                            '<div class="avatar-user">' +
                            '<svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true">' +
                            '<path fill="currentColor" d="M12 12c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm0 2c-3.33 0-10 1.67-10 5v3h20v-3c0-3.33-6.67-5-10-5z"></path>' +
                            '</svg>' +
                            '</div>' +
                            '<div class="user-bubble">' +
                            escapeChatHtml(content) +
                            '</div>';
                    }

                    body.appendChild(row);
                    body.scrollTop = body.scrollHeight;
                }

                function addTypingMessage(id) {
                    const body = document.getElementById("chat-body");

                    if (!body) return;

                    const row = document.createElement("div");
                    row.className = "msg-row-bot";
                    row.id = id;

                    row.innerHTML =
                        '<div class="avatar-bot">' +
                        '<img src="' + MALIBAN_CHATBOT_ICON + '" alt="Chatbot" width="24" height="24" loading="lazy" decoding="async">' +
                        '</div>' +
                        '<div class="typing-bubble">' +
                        '<span></span><span></span><span></span>' +
                        '</div>';

                    body.appendChild(row);
                    body.scrollTop = body.scrollHeight;
                }

                async function sendMessage(manualText = null) {
                    const input = document.getElementById("userInput");
                    const text = manualText || (input ? input.value.trim() : "");

                    if (!text) return;

                    addMessage(text, "user");

                    if (input) input.value = "";

                    const typingId = "typing_" + Date.now();
                    addTypingMessage(typingId);

                    try {
                        const res = await fetch(MALIBAN_CHATBOT_WEBHOOK, {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                sessionId: sessionId,
                                chatInput: text,
                                route: "general"
                            })
                        });

                        const data = await res.json();
                        const typingRow = document.getElementById(typingId);

                        if (typingRow) typingRow.remove();

                        addMessage(
                            data.output || data.reply || "I didn't receive a response. Please try again.",
                            "bot",
                            true
                        );
                    } catch (e) {
                        const typingRow = document.getElementById(typingId);

                        if (typingRow) typingRow.remove();

                        addMessage("There was a connection error. Please try again later.", "bot");
                    }
                }

                function handleKeyPress(e) {
                    if (e.key === "Enter") {
                        e.preventDefault();
                        sendMessage();
                    }
                }
            </script>
        </div>

