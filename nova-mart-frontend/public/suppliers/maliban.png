        <script>
            var btn = $('#button');

            $(window).scroll(function () {
                if ($(window).scrollTop() > 300) {
                    btn.addClass('show');
                } else {
                    btn.removeClass('show');
                }
            });

            btn.on('click', function (e) {
                e.preventDefault();
                $('html, body').animate({ scrollTop: 0 }, '300');
            });
        </script>
        <script>
            $('.gmg-sp-header, .gmg-sp-close').click(function () {
                $('#gmg-side-popup').toggleClass('open');
            });

            $('#gmg-spf-button').click(function (e) {
                e.preventDefault();
                $('#gmg-side-popup-form').fadeIn('fast');
            });

            $('.gmg-spf-overlay, .gmg-spf-close').click(function () {
                $('#gmg-side-popup-form').fadeOut('fast');
            });
        </script>
        <!-- Script to Activate the Carousel -->
        <script>
            $(function () {
                var $carousel = $('#my-pics');

                if ($carousel.length && $carousel.find('.item').length > 0) {
                    $carousel.carousel({
                        interval: 5000
                    });
                }

                $('.scroll-down').on('click', function () {
                    var $target = $('section.ok');

                    if ($target.length) {
                        $('html, body').animate({
                            scrollTop: $target.offset().top
                        }, 'slow');
                    }

                    return false;
                });

                if ($.fn.affix && $('nav').length) {
                    $('nav').affix({
                        offset: {
                            top: 205
                        }
                    });
                }
            });
        </script>


        <!--<script src="https://cdn.enable.co.il/licenses/enable-L8443s2wcpftljz-0421-46809/init.js"></script>-->
        <script>
            (function () {
                var quickSearchForm = document.getElementById('quickSearchForm');

                if (!quickSearchForm) {
                    return;
                }

                quickSearchForm.addEventListener('submit', function (e) {
                    e.preventDefault();

                    var queryInput = document.getElementById('quickSearchInput');
                    var feedback = document.getElementById('quickSearchFeedback');

                    if (!queryInput || !feedback) {
                        return;
                    }

                    var query = queryInput.value.trim();

                    if (!query) {
                        feedback.innerHTML = '<p>Please enter a search term.<\/p>';
                        return;
                    }

                    fetch('/wp-json/custom/v1/search?s=' + encodeURIComponent(query))
                        .then(function (response) {
                            return response.json();
                        })
                        .then(function (data) {
                            if (data.length === 1) {
                                window.location.href = data[0].link;
                            } else if (data.length > 1) {
                                feedback.innerHTML = '<p>Multiple matches found. Please be more specific.<\/p>';
                            } else {
                                feedback.innerHTML = '<p>No page found for "' + query + '".<\/p>';
                            }
                        })
                        .catch(function () {
                            feedback.innerHTML = '<p>Something went wrong. Try again.<\/p>';
                        });
                });
            })();
        </script>


        <script>
            (function () {
                var enableObserverStarted = false;
                var enableObserver = null;
                var enableScriptLoaded = false;

                function cleanText(el) {
                    return (el && el.textContent ? el.textContent : "")
                        .replace(/\s+/g, " ")
                        .trim();
                }

                function setAttr(el, name, value) {
                    if (el && el.getAttribute(name) !== value) {
                        el.setAttribute(name, value);
                    }
                }

                function setAccessibleName(el, label) {
                    if (!el) return;
                    setAttr(el, "aria-label", label);
                    setAttr(el, "title", label);
                }

                function removeBrokenAriaLabelledBy(el, fallbackLabel) {
                    if (!el || !el.hasAttribute("aria-labelledby")) return;

                    var ids = el.getAttribute("aria-labelledby").split(/\s+/).filter(Boolean);
                    var hasValidId = ids.some(function (id) {
                        return document.getElementById(id);
                    });

                    if (!hasValidId) {
                        el.removeAttribute("aria-labelledby");
                        setAccessibleName(el, fallbackLabel);
                    }
                }

                function getEnableLabel(el) {
                    var text = cleanText(el);
                    var cls = (el.className || "").toString().toLowerCase();
                    var lang = (el.getAttribute("data-enable-lang") || "").toLowerCase();

                    if (lang === "en_us") return "Switch accessibility language to English";
                    if (lang === "he_il") return "Switch accessibility language to Hebrew";
                    if (text) return text;

                    if (cls.indexOf("tr-trigger") !== -1) return "Switch accessibility language";
                    if (cls.indexOf("close") !== -1) return "Close accessibility toolbar";
                    if (cls.indexOf("stopblinks") !== -1) return "Stop blinking content";
                    if (cls.indexOf("monochrome") !== -1) return "Enable monochrome mode";
                    if (cls.indexOf("sepia") !== -1) return "Enable sepia mode";
                    if (cls.indexOf("highcontrast") !== -1) return "Enable high contrast mode";
                    if (cls.indexOf("blackyellow") !== -1) return "Enable black and yellow contrast";
                    if (cls.indexOf("invert") !== -1) return "Invert colors";
                    if (cls.indexOf("highlightstitles") !== -1) return "Highlight titles";
                    if (cls.indexOf("highlightslinks") !== -1) return "Highlight links";
                    if (cls.indexOf("tooltipvisible") !== -1) return "Show tooltips";
                    if (cls.indexOf("readablefonts") !== -1) return "Use readable fonts";
                    if (cls.indexOf("increasefont") !== -1) return "Increase font size";
                    if (cls.indexOf("decreasefont") !== -1) return "Decrease font size";
                    if (cls.indexOf("zoomincrease") !== -1) return "Increase zoom";
                    if (cls.indexOf("zoomdecrease") !== -1) return "Decrease zoom";

                    return "Accessibility option";
                }

                function fixEnableAccessibilityIssues() {
                    var toolbar = document.getElementById("enable-toolbar-buttons");

                    if (toolbar) {
                        toolbar.removeAttribute("aria-labelledby");
                        toolbar.setAttribute("aria-label", "Accessibility toolbar");
                        toolbar.setAttribute("title", "Accessibility toolbar");
                        toolbar.setAttribute("role", "menu");
                    }

                    var enableModal = document.getElementById("enable-modal");

                    if (enableModal) {
                        enableModal.removeAttribute("aria-labelledby");
                        setAccessibleName(enableModal, "Accessibility settings");
                    }

                    var trigger =
                        document.getElementById("enable-toolbar-trigger") ||
                        document.querySelector(".enable-toolbar-trigger, [class*='enable-toolbar-trigger']");

                    if (trigger) {
                        setAccessibleName(trigger, "Open accessibility toolbar");
                    }

                    document.querySelectorAll("[role='dialog'], [role='alertdialog']").forEach(function (dialog) {
                        removeBrokenAriaLabelledBy(dialog, "Accessibility dialog");

                        if (!dialog.getAttribute("aria-label") && !dialog.getAttribute("aria-labelledby")) {
                            setAccessibleName(dialog, "Accessibility dialog");
                        }
                    });

                    document.querySelectorAll(
                        "#enable-toolbar [role='menuitem'], #enable-toolbar-buttons [role='menuitem'], #enable-toolbar-links [role='menuitem'], #enable-modal [role='menuitem'], li[class*='enable-button'][role='menuitem']"
                    ).forEach(function (item) {
                        var label = getEnableLabel(item);

                        item.setAttribute("role", "menuitem");
                        item.setAttribute("tabindex", "0");

                        setAccessibleName(item, label);
                        removeBrokenAriaLabelledBy(item, label);
                    });

                    document.querySelectorAll(
                        "#enable-toolbar button, #enable-toolbar-links button, #enable-modal button, button[class*='enable'], button.tr-trigger"
                    ).forEach(function (button) {
                        setAccessibleName(button, getEnableLabel(button));
                    });

                    document.querySelectorAll(
                        "#enable-toolbar a, #enable-toolbar-links a, #enable-modal a, a[class*='enable']"
                    ).forEach(function (link) {
                        setAccessibleName(link, getEnableLabel(link));
                    });

                    document.querySelectorAll("[aria-labelledby]").forEach(function (el) {
                        removeBrokenAriaLabelledBy(el, cleanText(el) || "Accessibility element");
                    });
                }

                function startEnableObserver() {
                    if (enableObserverStarted || !document.body) return;

                    enableObserverStarted = true;

                    enableObserver = new MutationObserver(function () {
                        window.requestAnimationFrame(fixEnableAccessibilityIssues);
                    });

                    enableObserver.observe(document.body, {
                        childList: true,
                        subtree: true,
                        attributes: true,
                        attributeFilter: ["aria-labelledby", "role", "id", "class", "data-enable-lang", "aria-label"]
                    });

                    setTimeout(function () {
                        if (enableObserver) {
                            enableObserver.disconnect();
                        }
                    }, 45000);
                }

                function loadEnableWidget() {
                    if (enableScriptLoaded) return;

                    enableScriptLoaded = true;

                    var enableScript = document.createElement("script");
                    enableScript.src = "https://cdn.enable.co.il/licenses/enable-L8443s2wcpftljz-0421-78957/init.js";
                    enableScript.async = true;

                    enableScript.onload = function () {
                        fixEnableAccessibilityIssues();
                        startEnableObserver();

                        setTimeout(fixEnableAccessibilityIssues, 500);
                        setTimeout(fixEnableAccessibilityIssues, 1500);
                        setTimeout(fixEnableAccessibilityIssues, 3000);
                        setTimeout(fixEnableAccessibilityIssues, 6000);
                        setTimeout(fixEnableAccessibilityIssues, 10000);
                        setTimeout(fixEnableAccessibilityIssues, 15000);
                        setTimeout(fixEnableAccessibilityIssues, 25000);
                        setTimeout(fixEnableAccessibilityIssues, 35000);
                    };

                    document.body.appendChild(enableScript);
                    startEnableObserver();
                }

                window.addEventListener("load", function () {
                    ["scroll", "mousemove", "touchstart", "keydown"].forEach(function (eventName) {
                        window.addEventListener(eventName, loadEnableWidget, {
                            once: true,
                            passive: true
                        });
                    });
                });
            })();
        </script>

        <!-- Keep old direct Enable script commented -->
        <!--<script src="https://cdn.enable.co.il/licenses/enable-L8443s2wcpftljz-0421-46809/init.js"></script>-->




        <script>
            (function () {
                var typekitLoaded = false;

                function loadTypekitAfterInitialRender() {
                    if (typekitLoaded) return;
                    typekitLoaded = true;

                    var typekitScript = document.createElement('script');
                    typekitScript.src = 'https://use.typekit.net/yzd0zyt.js';
                    typekitScript.async = true;

                    typekitScript.onload = function () {
                        try {
                            Typekit.load({
                                async: true,
                                timeout: 1000
                            });
                        } catch (e) { }
                    };

                    document.body.appendChild(typekitScript);
                }

                window.addEventListener('load', function () {
                    setTimeout(loadTypekitAfterInitialRender, 6000);
                });

                ['scroll', 'mousemove', 'touchstart', 'keydown'].forEach(function (eventName) {
                    window.addEventListener(eventName, loadTypekitAfterInitialRender, {
                        once: true,
                        passive: true
                    });
                });
            })();
        </script>
























</body>

</html>