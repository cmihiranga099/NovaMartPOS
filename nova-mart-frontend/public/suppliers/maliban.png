                display: inline-block;
                background-color: #d8262f;
                width: 50px;
                height: 50px;
                text-align: center;
                border-radius: 4px;
                position: fixed;
                bottom: 50px;
                right: 20px;
                transition: background-color .3s,
                    opacity .5s, visibility .5s;
                opacity: 0;
                visibility: hidden;
                z-index: 1000;
                text-decoration: none;
            }

            #button::after {
                content: "\f077";
                font-family: FontAwesome;
                font-weight: normal;
                font-style: normal;
                font-size: 2em;
                line-height: 50px;
                color: #fff;
            }

            #button:hover {
                cursor: pointer;
                background-color: #333;
            }

            #button:active {
                background-color: #555;
            }

            #button.show {
                opacity: 1;
                visibility: visible;
            }

